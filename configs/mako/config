# ~/.config/mako/config
font=Scientifica 10
background-color=#1c1c1c
text-color=#f5f5dc
border-color=#2a2a2a
border-size=2
padding=12
default-timeout=10000
max-history=50
sort=-time

anchor=top-right


[app-name="screenshot"]
on-button-left=exec thunar ~/Pictures/Screenshots

[app-name="record"]
on-button-left=exec thunar ~/Videos/Captures
